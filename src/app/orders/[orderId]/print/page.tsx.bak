"use client";

import React from "react";
import { onAuthStateChanged, type User } from "firebase/auth";
import { clientAuth } from "@/lib/firebase/client";
import { useParams, useRouter, useSearchParams } from "next/navigation";
import { getLang, t, type Lang } from "@/lib/i18n";

function safe(v: unknown) {
  return String(v ?? "").trim();
}

async function apiFetch(user: User, path: string, init: RequestInit = {}) {
  const token = await user.getIdToken();
  const headers = new Headers(init.headers || {});
  headers.set("authorization", `Bearer ${token}`);
  return fetch(path, { ...init, headers });
}

type PurchaseState = "PENDING" | "BOUGHT" | "NOT_BOUGHT";

function consolidate(items: any[], state: PurchaseState) {
  const m = new Map<string, { name: string; unit: string; sum: number; notes: Set<string> }>();

  for (const it of items) {
    const st = String(it?.purchaseState || "PENDING") as PurchaseState;
    if (st !== state) continue;

    const name = safe(it?.productName) || "Artículo";
    const unit = safe(it?.unitCapture);
    const pid = safe(it?.productId);
    const key = `${(pid || name).toLowerCase()}__${unit}`;

    const rawQty = safe(it?.needQty);
    const n = Number(rawQty.replace(",", "."));
    const note = safe(it?.note);

    const cur = m.get(key) || { name, unit, sum: 0, notes: new Set<string>() };
    if (Number.isFinite(n)) cur.sum += n;
    if (note) cur.notes.add(note);
    m.set(key, cur);
  }

  return Array.from(m.values()).sort((a, b) => a.name.localeCompare(b.name));
}

export default function PrintOrderPage() {
  const r = useRouter();
  const sp = useSearchParams();
  const params = useParams<{ orderId: string }>();

  const [lang, setLang] = React.useState<Lang>("es");
  const [user, setUser] = React.useState<User | null>(null);
  const [order, setOrder] = React.useState<any>(null);
  const [msg, setMsg] = React.useState("");
  const [qrDataUrl, setQrDataUrl] = React.useState<string>("");
  const [qrErr, setQrErr] = React.useState<string>("");

  const orderId = decodeURIComponent(params.orderId || "");
  const branch = sp.get("branch") || "sucursal-a";

  React.useEffect(() => {
    const sync = () => setLang(getLang());
    sync();
    window.addEventListener("langchange", sync);
    return () => window.removeEventListener("langchange", sync);
  }, []);

  React.useEffect(() => {
    const unsub = onAuthStateChanged(clientAuth(), (u) => {
      if (!u) return r.replace("/login");
      setUser(u);
    });
    return () => unsub();
  }, [r]);

  const load = React.useCallback(async () => {
    if (!user) return;
    setMsg("");
    const res = await apiFetch(user, `/api/orders/${encodeURIComponent(orderId)}?branch=${encodeURIComponent(branch)}`);
    const json = await res.json();
    if (!res.ok) throw new Error(json?.error || "Error");
    setOrder(json.order);
  }, [user, orderId, branch]);

  React.useEffect(() => {
    if (!user) return;
    void load().catch((e) => setMsg(`⚠ ${String(e?.message || e)}`));
  }, [user, load]);

  React.useEffect(() => {
    if (!order) return;
    (async () => {
      try {
        setQrErr("");
        const url = `${window.location.origin}/orders/${encodeURIComponent(orderId)}?branch=${encodeURIComponent(branch)}`;
        // evita error de build si no existe el paquete
        const mod: any = await (0, eval)("import('qrcode')");
        const QR: any = mod?.default || mod;
        const dataUrl = await QR.toDataURL(url, { margin: 1, width: 220 });
        setQrDataUrl(String(dataUrl || ""));
      } catch (e) {
        setQrDataUrl("");
        setQrErr("QR no disponible (instala el paquete qrcode)");
      }
    })();
  }, [order, orderId, branch]);

  if (!order) {
    return (
      <main style={{ maxWidth: 820, margin: "0 auto", padding: 14, fontFamily: "system-ui" }}>
        {msg ? <div style={{ color: "crimson" }}>{msg}</div> : <div>Cargando…</div>}
      </main>
    );
  }

  const items: any[] = Array.isArray(order?.items) ? order.items : [];
  const supplier = order?.supplier || {};
  const supplierName = safe(supplier?.name) || safe(order?.supplierName) || "Proveedor";

  const addr = [
    safe(supplier?.addressLine1),
    safe(supplier?.city),
    safe(supplier?.state),
    safe(supplier?.postalCode),
  ]
    .filter(Boolean)
    .join(", ");

  const phone = safe(supplier?.phone);

  const orderNo = safe(order?.orderNo);
  const createdAt = safe(order?.createdAt);

  const pending = consolidate(items, "PENDING");
  const bought = consolidate(items, "BOUGHT");
  const notBought = consolidate(items, "NOT_BOUGHT");

  const Section = (p: { title: string; rows: { name: string; unit: string; sum: number; notes: Set<string> }[] }) => {
    if (!p.rows.length) return null;
    return (
      <section style={{ marginTop: 16 }}>
        <h3 style={{ margin: "10px 0" }}>{p.title}</h3>
        <div style={{ border: "1px solid #eee", borderRadius: 14, overflow: "hidden" }}>
          {p.rows.map((x, i) => (
            <div
              key={x.name + i}
              style={{
                display: "grid",
                gridTemplateColumns: "1fr 140px 1fr",
                gap: 10,
                padding: 10,
                borderTop: i ? "1px solid #eee" : "none",
              }}
            >
              <div style={{ fontWeight: 900 }}>{x.name}</div>
              <div style={{ textAlign: "right", fontWeight: 900 }}>
                {x.sum} {x.unit}
              </div>
              <div style={{ opacity: 0.8, fontSize: 12 }}>{Array.from(x.notes).join(" | ")}</div>
            </div>
          ))}
        </div>
      </section>
    );
  };

  return (
    <main style={{ maxWidth: 820, margin: "0 auto", padding: 14, fontFamily: "system-ui" }}>
      {/* HEADER */}
      <header style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", gap: 14 }}>
        <div>
          <div style={{ fontWeight: 1000, fontSize: 18 }}>{lang === "en" ? "Purchases Carnitas El Cliente" : "Compras Carnitas El Cliente"}</div>
          <div style={{ marginTop: 6, fontWeight: 900, fontSize: 16 }}>{supplierName}</div>
          {addr ? <div style={{ marginTop: 2, opacity: 0.85 }}>{addr}</div> : null}
          {phone ? <div style={{ marginTop: 2, opacity: 0.85 }}>{phone}</div> : null}
          <div style={{ marginTop: 8, opacity: 0.8 }}>
            {lang === "en" ? "Branch" : "Sucursal"}: <b>{branch}</b>
            {createdAt ? <span> • {createdAt}</span> : null}
          </div>
          {orderNo ? (
            <div style={{ marginTop: 6, opacity: 0.9 }}>
              {lang === "en" ? "Order #" : "Orden #"} <b>{orderNo}</b>
            </div>
          ) : null}
        </div>

        <div style={{ textAlign: "right" }}>
          {qrDataUrl ? <img src={qrDataUrl} alt="QR" style={{ width: 120, height: 120 }} /> : null}
          {!qrDataUrl && qrErr ? <div style={{ fontSize: 12, opacity: 0.7 }}>{qrErr}</div> : null}
        </div>
      </header>

      <Section title={lang === "en" ? "Pending" : "Pendientes"} rows={pending} />
      <Section title={lang === "en" ? "Bought" : "Comprados"} rows={bought} />
      <Section title={lang === "en" ? "Not bought" : "No comprados"} rows={notBought} />

      <div style={{ marginTop: 18, opacity: 0.7, fontSize: 12 }}>
        {lang === "en" ? "Generated by Carnitas El Cliente - Purchases" : "Generado por Carnitas El Cliente - Compras"}
      </div>
    </main>
  );
}