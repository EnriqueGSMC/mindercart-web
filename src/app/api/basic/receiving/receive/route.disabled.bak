// FILE: src/app/api/basic/receiving/receive/route.ts
import { NextResponse } from "next/server";
import { getCurrentUserIdOrThrow } from "@/lib/authServer";
import { getUserLite } from "@/lib/receivingRepo"; // si no tienes esto, borra y usa fallback
import { receiveOrder } from "@/lib/receivingRepo";

type Body = {
  orderId: string;
  deliveredByName: string;
  receivedItemIds: string[];
};

export async function POST(req: Request) {
  try {
    const receivedByUserId = getCurrentUserIdOrThrow();

    const body = (await req.json()) as Body;
    if (!body?.orderId) return NextResponse.json({ error: "orderId requerido" }, { status: 400 });
    if (!body?.deliveredByName?.trim())
      return NextResponse.json({ error: "Quién entrega es requerido" }, { status: 400 });

    const me = await getUserLite(receivedByUserId).catch(() => null);

    const result = await receiveOrder({
      orderId: body.orderId,
      deliveredByName: body.deliveredByName,
      receivedByUserId,
      receivedByName: me?.name ?? "Usuario",
      receivedItemIds: body.receivedItemIds ?? [],
    });

    return NextResponse.json({ ok: true, receiptType: result.receiptType });
  } catch (err: any) {
    return NextResponse.json({ error: err?.message ?? "Error" }, { status: 500 });
  }
}