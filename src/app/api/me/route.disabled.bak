// FILE: src/app/api/me/route.ts
import { NextResponse } from "next/server";
import { getCurrentUserIdOrThrow } from "@/lib/authServer";
import { getUserLite } from "@/lib/receivingRepo";

export async function GET() {
  const userId = getCurrentUserIdOrThrow();
  const user = await getUserLite(userId);
  return NextResponse.json({ user: user ?? { id: userId, name: "Usuario" } });
}